<?xml version="1.0" encoding="UTF-8"?>
<!--
  DUMMY-DATEI. Enthaelt ausschliesslich erfundene Zugangsdaten fuer die
  Demonstration. Dieses Verzeichnis dient als gefaelschtes HOME (M2_HOME /
  user.home), damit das Angriffsszenario NIE die echte ~/.m2/settings.xml
  des Nutzers beruehrt. Die Werte unten sind frei erfunden.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0">
    <servers>
        <server>
            <id>internal-releases</id>
            <username>deploy-bot</username>
            <!-- FAKE: kein echtes Secret -->
            <password>DUMMY-NOT-A-REAL-TOKEN-0000</password>
        </server>
    </servers>
    <profiles>
        <profile>
            <id>internal</id>
            <properties>
                <!-- FAKE: Beispiel-URL eines fiktiven internen Nexus -->
                <deploy.url>https://nexus.internal.example/repository/releases</deploy.url>
            </properties>
        </profile>
    </profiles>
</settings>
