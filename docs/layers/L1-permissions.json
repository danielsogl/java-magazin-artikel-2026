{
  "permissions": {
    "deny": [
      "Read(**/settings.xml)",
      "Read(**/.env)",
      "Bash(curl:*)",
      "Bash(wget:*)"
    ],
    "ask": [
      "Bash(mvn deploy:*)",
      "Bash(gradlew publish:*)"
    ],
    "allow": [
      "Bash(mvn -q test:*)",
      "Read(src/**)",
      "Read(pom.xml)"
    ]
  }
}